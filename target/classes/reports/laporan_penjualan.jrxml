<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="laporan_penjualan" language="java"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="786" leftMargin="28" rightMargin="28"
              topMargin="24" bottomMargin="24"
              whenNoDataType="AllSectionsNoDetail"
              uuid="7d6f5c2a-1b4e-4c8f-9a3d-2e5b7c1f8a90">

    <property name="com.jaspersoft.studio.data.defaultdataadapter" value="PesanYuk MySQL"/>

    <style name="Dasar" fontName="SansSerif" fontSize="8" forecolor="#1F2937"/>
    <style name="Muted" fontName="SansSerif" fontSize="7.5" forecolor="#6B7280"/>
    <style name="Header" fontName="SansSerif" fontSize="8" isBold="true" forecolor="#9A3412"/>

    <parameter name="DARI" class="java.sql.Timestamp" isForPrompting="false"/>
    <parameter name="SAMPAI" class="java.sql.Timestamp" isForPrompting="false"/>
    <parameter name="UMKM_ID" class="java.lang.Integer" isForPrompting="false">
        <defaultValueExpression><![CDATA[-1]]></defaultValueExpression>
    </parameter>
    <parameter name="LINGKUP" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["Semua UMKM"]]></defaultValueExpression>
    </parameter>
    <parameter name="PERIODE" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>
    <parameter name="DICETAK" class="java.lang.String" isForPrompting="false">
        <defaultValueExpression><![CDATA["-"]]></defaultValueExpression>
    </parameter>

    <queryString language="SQL">
        <![CDATA[
SELECT p.kode,
       p.dibuat_pada,
       pg.nama AS pelanggan,
       u.nama_umkm,
       p.jenis,
       COALESCE(pb.metode, '-') AS metode,
       p.subtotal
FROM pesanan p
JOIN pengguna pg ON pg.id = p.pelanggan_id
JOIN umkm u ON u.id = p.umkm_id
LEFT JOIN pembayaran pb ON pb.pesanan_id = p.id
WHERE p.status = 'SELESAI'
  AND p.dibuat_pada >= $P{DARI}
  AND p.dibuat_pada < $P{SAMPAI}
  AND ($P{UMKM_ID} < 0 OR p.umkm_id = $P{UMKM_ID})
ORDER BY p.dibuat_pada, p.kode
        ]]>
    </queryString>

    <field name="kode" class="java.lang.String"/>
    <field name="dibuat_pada" class="java.sql.Timestamp"/>
    <field name="pelanggan" class="java.lang.String"/>
    <field name="nama_umkm" class="java.lang.String"/>
    <field name="jenis" class="java.lang.String"/>
    <field name="metode" class="java.lang.String"/>
    <field name="subtotal" class="java.math.BigDecimal"/>

    <variable name="TotalOmzet" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{subtotal}]]></variableExpression>
        <initialValueExpression><![CDATA[new java.math.BigDecimal("0")]]></initialValueExpression>
    </variable>

